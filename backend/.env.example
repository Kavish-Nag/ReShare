NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://reshare:local_only_password@localhost:5432/reshare
DB_SSL=false

# Local database-backed login for the starter project. Use a long random secret.
AUTH_MODE=local
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long

# Optional Cognito configuration if you explicitly configure Cognito mode.
COGNITO_REGION=ap-south-1
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=

ALLOWED_ORIGINS=http://localhost:5173
AWS_REGION=ap-south-1
S3_BUCKET=
S3_PUBLIC_BASE_URL=
SQS_DELIVERY_QUEUE_URL=

# Set by ECS in AWS (notifications via SNS; DB_* used instead of DATABASE_URL)
SNS_ORDER_EVENTS_TOPIC_ARN=
