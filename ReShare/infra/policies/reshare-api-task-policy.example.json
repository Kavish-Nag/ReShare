{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "UploadListingImages",
      "Effect": "Allow",
      "Action": ["s3:PutObject"],
      "Resource": ["arn:aws:s3:::REPLACE_WITH_PRIVATE_IMAGE_BUCKET/listings/*"]
    },
    {
      "Sid": "QueueDeliveryAssignments",
      "Effect": "Allow",
      "Action": ["sqs:SendMessage"],
      "Resource": ["REPLACE_WITH_DELIVERY_QUEUE_ARN"]
    }
  ]
}
